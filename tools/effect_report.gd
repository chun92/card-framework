extends SceneTree
## Effect review report (Design Document 7.8). Not part of the game; run it by hand.
##
## From the project root:
##   godot --headless --path . --script res://tools/effect_report.gd
##
## Reads every card in data/tcgdex/ and writes res://reports/effect_review.md with:
##   - A summary of how much of the pool has effect text.
##   - Effect texts shared by several cards, most repeated first, with every name they use.
##   - Every attack, Pokemon Power, Trainer and Special Energy with text, grouped by printed
##     name, with each distinct text and the cards that print it.
## When data/effects/card_effects.json exists, it also lists every function with the cards
## that call it, printed text and arguments side by side; printed effects without an entry;
## and printed names bound to different functions on different cards.
##
## Texts are compared after replacing the card's own name with {self}, so "attached to
## Charmander" and "attached to Charmeleon" count as the same text. Every card links to its
## image, because TCGdex text is not always complete: it drops Energy symbols, for example.

const OUTPUT_PATH := "res://reports/effect_review.md"
const CARD_EFFECTS_PATH := "res://data/effects/card_effects.json"
const SELF_TOKEN := "{self}"

const KIND_ATTACK := "attack"
const KIND_POWER := "power"
const KIND_TRAINER := "trainer"
const KIND_ENERGY := "energy"
const KIND_ORDER := [KIND_ATTACK, KIND_POWER, KIND_TRAINER, KIND_ENERGY]
const KIND_TITLES := {
	KIND_ATTACK: "Attacks",
	KIND_POWER: "Pokemon Powers",
	KIND_TRAINER: "Trainers",
	KIND_ENERGY: "Special Energy",
}
## Section of card_effects.json each kind is declared under (Design Document 7.1).
const KIND_SECTIONS := {
	KIND_ATTACK: "attacks",
	KIND_POWER: "powers",
	KIND_TRAINER: "trainer",
	KIND_ENERGY: "energy",
}

var _lines: PackedStringArray = PackedStringArray()


func _initialize() -> void:
	var database := DataLoader.load_card_database()
	if database.card_count() == 0:
		printerr("No cards loaded. Run tools/import_tcgdex.gd first.")
		quit(1)
		return

	var cards: Array[CardData] = []
	for id in database.all_ids():
		cards.append(database.make(id))
	cards.sort_custom(_by_set_and_number)

	var stats := {"attacks": 0, "vanilla_attacks": 0}
	var entries := _collect_entries(cards, stats)
	var card_effects := _load_card_effects()

	_write_header(cards, entries, stats, card_effects)
	_write_shared_texts(entries)
	if not card_effects.is_empty():
		_write_functions(entries, card_effects)
	for kind: String in KIND_ORDER:
		_write_kind(kind, entries)

	if not _save():
		quit(1)
		return
	print("Wrote %s (%d effect entries)" % [OUTPUT_PATH, entries.size()])
	quit(0)


## One entry per printed effect: an attack with text or a damage suffix, a Power, a Trainer
## or a Special Energy.
func _collect_entries(cards: Array[CardData], stats: Dictionary) -> Array[Dictionary]:
	var entries: Array[Dictionary] = []
	for card in cards:
		for attack in card.attacks:
			stats["attacks"] = int(stats["attacks"]) + 1
			if not attack.has_effect():
				stats["vanilla_attacks"] = int(stats["vanilla_attacks"]) + 1
				continue
			var damage := "%d%s" % [attack.damage, attack.damage_suffix] if attack.damage > 0 or not attack.damage_suffix.is_empty() else "-"
			entries.append(_entry(KIND_ATTACK, attack.name, attack.effect_text, card,
				"cost %s, damage %s" % [_cost_text(attack.cost), damage]))
		for power in card.powers:
			entries.append(_entry(KIND_POWER, power.name, power.effect_text, card, power.kind))
		if card.is_trainer():
			entries.append(_entry(KIND_TRAINER, card.name, card.effect_text, card, card.rarity))
		if card.is_energy() and card.energy_kind == CardData.ENERGY_SPECIAL:
			entries.append(_entry(KIND_ENERGY, card.name, card.effect_text, card, card.rarity))
	return entries


func _entry(kind: String, name: String, text: String, card: CardData, detail: String) -> Dictionary:
	var normalized := text.strip_edges().replace(card.name, SELF_TOKEN) if not card.name.is_empty() else text.strip_edges()
	return {
		"kind": kind,
		"name": name,
		"text": text.strip_edges(),
		"normalized": normalized,
		"card": card,
		"detail": detail,
	}


func _write_header(cards: Array[CardData], entries: Array[Dictionary], stats: Dictionary, card_effects: Dictionary) -> void:
	var by_category := {}
	for card in cards:
		by_category[card.category] = int(by_category.get(card.category, 0)) + 1

	var sets := {}
	for card in cards:
		sets[card.set_id] = true
	var set_ids: Array = sets.keys()
	set_ids.sort()

	_add("# Effect review report")
	_add("")
	_add("Generated by `tools/effect_report.gd` from `data/tcgdex/` (%s). Do not edit by hand." % ", ".join(PackedStringArray(set_ids)))
	_add("")
	_add("## Summary")
	_add("")
	_add("| | Count |")
	_add("| --- | ---: |")
	_add("| Cards | %d |" % cards.size())
	for category: String in [CardData.CATEGORY_POKEMON, CardData.CATEGORY_TRAINER, CardData.CATEGORY_ENERGY]:
		_add("| %s cards | %d |" % [category, int(by_category.get(category, 0))])
	var attacks := int(stats["attacks"])
	var vanilla := int(stats["vanilla_attacks"])
	_add("| Attacks | %d |" % attacks)
	_add("| Attacks without effect text (no entry needed) | %d |" % vanilla)
	for kind: String in KIND_ORDER:
		var kind_entries := _of_kind(entries, kind)
		_add("| %s with effect text | %d |" % [_title(kind), kind_entries.size()])
		_add("| %s: distinct names | %d |" % [_title(kind), _distinct(kind_entries, "name").size()])
		_add("| %s: distinct texts | %d |" % [_title(kind), _distinct(kind_entries, "normalized").size()])
	_add("")
	if card_effects.is_empty():
		_add("`data/effects/card_effects.json` does not exist yet, so function coverage is not reported.")
	else:
		var covered := 0
		for entry in entries:
			if _binding(card_effects, entry) != null:
				covered += 1
		_add("Card effect entries cover %d of %d printed effects." % [covered, entries.size()])
	_add("")


## Normalized texts printed on more than one card, most repeated first.
func _write_shared_texts(entries: Array[Dictionary]) -> void:
	var groups := {}
	for entry in entries:
		var key := "%s\n%s" % [entry["kind"], entry["normalized"]]
		if not groups.has(key):
			groups[key] = []
		(groups[key] as Array).append(entry)

	var shared: Array = []
	for key: String in groups:
		var group := groups[key] as Array
		if group.size() > 1 and not str((group[0] as Dictionary)["normalized"]).is_empty():
			shared.append(group)
	shared.sort_custom(func(a: Array, b: Array) -> bool:
		if a.size() != b.size():
			return a.size() > b.size()
		return str((a[0] as Dictionary)["normalized"]) < str((b[0] as Dictionary)["normalized"]))

	_add("## Effect texts shared by several cards")
	_add("")
	_add("The strongest candidates for a single function. Names listed together print the same text.")
	_add("")
	for group: Array in shared:
		var first := group[0] as Dictionary
		var names: Array = []
		for entry: Dictionary in group:
			if not names.has(entry["name"]):
				names.append(entry["name"])
		_add("- **%d cards**, %s: %s" % [group.size(), _title(str(first["kind"])).to_lower(), ", ".join(PackedStringArray(names))])
		_add("  > %s" % first["normalized"])
	_add("")


func _write_kind(kind: String, entries: Array[Dictionary]) -> void:
	var kind_entries := _of_kind(entries, kind)
	if kind_entries.is_empty():
		return

	var by_name := {}
	for entry in kind_entries:
		var name := str(entry["name"])
		if not by_name.has(name):
			by_name[name] = []
		(by_name[name] as Array).append(entry)
	var names: Array = by_name.keys()
	names.sort_custom(func(a: String, b: String) -> bool: return a.naturalnocasecmp_to(b) < 0)

	_add("## %s" % _title(kind))
	_add("")
	for name: String in names:
		var group := by_name[name] as Array
		var texts := {}
		var text_order: Array = []
		for entry: Dictionary in group:
			var normalized := str(entry["normalized"])
			if not texts.has(normalized):
				texts[normalized] = []
				text_order.append(normalized)
			(texts[normalized] as Array).append(entry)

		var heading := "### %s" % name
		if text_order.size() > 1:
			heading += " (%d different texts)" % text_order.size()
		_add(heading)
		_add("")
		for normalized: String in text_order:
			_add("> %s" % (normalized if not normalized.is_empty() else "*(no text: effect is only the damage suffix)*"))
			_add("")
			for entry: Dictionary in texts[normalized]:
				var card := entry["card"] as CardData
				_add("- `%s` %s · %s · %s" % [card.id, card.name, entry["detail"], _image_link(card)])
			_add("")


func _write_functions(entries: Array[Dictionary], card_effects: Dictionary) -> void:
	var by_function := {}
	var missing: Array[Dictionary] = []
	var functions_by_name := {}
	for entry in entries:
		var binding: Variant = _binding(card_effects, entry)
		if binding == null:
			missing.append(entry)
			continue
		var function_name := str((binding as Dictionary).get("function", ""))
		if not by_function.has(function_name):
			by_function[function_name] = []
		(by_function[function_name] as Array).append({"entry": entry, "args": (binding as Dictionary).get("args", {})})
		var name_key := "%s: %s" % [_title(str(entry["kind"])), entry["name"]]
		if not functions_by_name.has(name_key):
			functions_by_name[name_key] = {}
		(functions_by_name[name_key] as Dictionary)[function_name] = true

	_add("## Functions")
	_add("")
	var function_names: Array = by_function.keys()
	function_names.sort()
	for function_name: String in function_names:
		var uses := by_function[function_name] as Array
		_add("### %s (%d %s)" % [function_name, uses.size(), "card" if uses.size() == 1 else "cards"])
		_add("")
		_add("| Card | Name | Printed text | Arguments |")
		_add("| --- | --- | --- | --- |")
		for use: Dictionary in uses:
			var entry := use["entry"] as Dictionary
			var card := entry["card"] as CardData
			_add("| `%s` %s | %s | %s | `%s` |" % [card.id, card.name, entry["name"], _cell(str(entry["text"])), _args_text(use["args"])])
		_add("")

	_add("## Same name, different functions")
	_add("")
	var conflicts := 0
	var name_keys: Array = functions_by_name.keys()
	name_keys.sort()
	for name_key: String in name_keys:
		var functions := (functions_by_name[name_key] as Dictionary).keys()
		if functions.size() > 1:
			functions.sort()
			_add("- %s → %s" % [name_key, ", ".join(PackedStringArray(functions))])
			conflicts += 1
	if conflicts == 0:
		_add("None.")
	_add("")

	_add("## Printed effects without an entry (%d)" % missing.size())
	_add("")
	for entry in missing:
		var card := entry["card"] as CardData
		_add("- `%s` %s · %s: %s" % [card.id, card.name, _title(str(entry["kind"])).to_lower(), entry["name"]])
	_add("")


## The {function, args} object declared for an entry, or null.
func _binding(card_effects: Dictionary, entry: Dictionary) -> Variant:
	var card := entry["card"] as CardData
	var card_entry: Variant = card_effects.get(card.id)
	if not card_entry is Dictionary:
		return null
	var section: Variant = (card_entry as Dictionary).get(KIND_SECTIONS[entry["kind"]])
	if not section is Dictionary:
		return null
	var section_dict := section as Dictionary
	if entry["kind"] == KIND_ATTACK or entry["kind"] == KIND_POWER:
		var binding: Variant = section_dict.get(entry["name"])
		if binding is Dictionary:
			return binding
		return null
	if section_dict.has("function"):
		return section_dict
	return null


func _load_card_effects() -> Dictionary:
	if not FileAccess.file_exists(CARD_EFFECTS_PATH):
		return {}
	var parsed: Variant = DataLoader.read_json(CARD_EFFECTS_PATH)
	if not parsed is Dictionary:
		printerr("%s is not a JSON object; function coverage is skipped" % CARD_EFFECTS_PATH)
		return {}
	return parsed as Dictionary


func _of_kind(entries: Array[Dictionary], kind: String) -> Array[Dictionary]:
	var result: Array[Dictionary] = []
	for entry in entries:
		if entry["kind"] == kind:
			result.append(entry)
	return result


func _distinct(entries: Array[Dictionary], key: String) -> Dictionary:
	var values := {}
	for entry in entries:
		values[entry[key]] = true
	return values


## Relative link from reports/ to the card art, so the printed card can be checked when
## the TCGdex text is incomplete (it drops Energy symbols, for example).
func _image_link(card: CardData) -> String:
	return "[image](../assets/tcgdex/%s/%s.png)" % [card.set_id, card.id]


## JSON reads every number as a float; whole numbers are shown without ".0".
func _args_text(args: Variant) -> String:
	if not args is Dictionary:
		return JSON.stringify(args)
	var clean := {}
	for key: Variant in args as Dictionary:
		var value: Variant = (args as Dictionary)[key]
		if value is float and is_equal_approx(value as float, roundf(value as float)):
			clean[key] = int(value)
		else:
			clean[key] = value
	return JSON.stringify(clean)


func _title(kind: String) -> String:
	return str(KIND_TITLES[kind])


func _cost_text(cost: Array[String]) -> String:
	return "none" if cost.is_empty() else ", ".join(PackedStringArray(cost))


func _cell(text: String) -> String:
	return text.replace("|", "\\|").replace("\n", " ")


func _add(line: String) -> void:
	_lines.append(line)


func _save() -> bool:
	DirAccess.make_dir_recursive_absolute(OUTPUT_PATH.get_base_dir())
	var file := FileAccess.open(OUTPUT_PATH, FileAccess.WRITE)
	if file == null:
		printerr("Cannot write %s (error %d)" % [OUTPUT_PATH, FileAccess.get_open_error()])
		return false
	file.store_string("\n".join(_lines) + "\n")
	file.close()
	return true


func _by_set_and_number(a: CardData, b: CardData) -> bool:
	if a.set_id != b.set_id:
		return a.set_id < b.set_id
	if a.local_id.is_valid_int() and b.local_id.is_valid_int():
		return a.local_id.to_int() < b.local_id.to_int()
	return a.local_id.naturalnocasecmp_to(b.local_id) < 0
